# Docker Compose: copy to .env (not .env.local).
# Port published by a LOCAL/TEST Grocy installation on the Docker host.
GROCY_URL=http://host.docker.internal:9283
GROCY_API_KEY=
HOUSEHOLD_TIMEZONE=UTC
GROCY_SHOPPING_LIST_ID=
GROCY_DINNER_SECTION_ID=
# Optional, only for compose.grocy-network.yaml: your existing network name.
# Also change GROCY_URL to http://<Grocy service alias>:<internal port>.
GROCY_DOCKER_NETWORK=
